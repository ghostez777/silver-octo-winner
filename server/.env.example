# Copy this file to .env and replace every CHANGE_ME value.
DB_NAME=pokeroguedb
DB_USER=pokerogue
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

# The public origin that will be allowed by the PokéRogue API.
# Example: https://gamehub.ghostez.org
GAME_URL=https://YOUR-GAMEHUB-DOMAIN.example

# Keep false for a public deployment.
DEBUG=false
